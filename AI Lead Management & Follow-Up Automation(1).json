    {
      "parameters": {
        "jsCode": "\nconst lead = $json;\n\nlet score = 0;\n\n// 1. Budget scoring\nconst budget = Number(lead.budget) || 0;\n\nif (budget >= 2000) {\n  score += 40;\n} else if (budget >= 1000) {\n  score += 25;\n} else if (budget > 0) {\n  score += 10;\n}\n\n// 2. Message quality\nif (lead.message && lead.message.trim().length >= 30) {\n  score += 20;\n}\n\n// 3. Contact information\nif (lead.name && lead.email) {\n  score += 20;\n}\n\n// 4. Service requirement\nif (lead.service && lead.service.trim().length > 0) {\n  score += 20;\n}\n\n// Determine priority\nlet priority = \"Low\";\n\nif (score >= 70) {\n  priority = \"High\";\n} else if (score >= 40) {\n  priority = \"Medium\";\n}\n\nreturn {\n  ...lead,\n  leadScore: score,\n  priority: priority,\n  status: \"New\",\n  createdAt: new Date().toISOString()\n};\n"
      },
